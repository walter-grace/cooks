{
  "name": "cooks",
  "private": true,
  "version": "0.1.0",
  "description": "Cooks: free, open-source sales engagement (Nooks-compatible API + MCP server)",
  "license": "MIT",
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cooks/api dev",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @cooks/db generate",
    "db:migrate": "pnpm --filter @cooks/db migrate",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "spec:fetch": "tsx scripts/fetch-upstream-spec.ts",
    "conformance": "tsx scripts/conformance.ts",
    "seed": "tsx scripts/seed.ts",
    "web:build": "pnpm --filter @cooks/web build",
    "qa:hubspot": "node scripts/qa/hubspot-ui.mjs",
    "qa:mock-hubspot": "node scripts/qa/mock-hubspot.mjs",
    "qa:mock-twilio": "node scripts/qa/mock-twilio.mjs"
  },
  "devDependencies": {
    "@cooks/auth": "workspace:*",
    "@cooks/config": "workspace:*",
    "@cooks/core": "workspace:*",
    "@cooks/db": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-orm": "^0.45.0",
    "playwright-core": "1.57",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  }
}