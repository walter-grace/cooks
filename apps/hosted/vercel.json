{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "public",
  "functions": {
    "api/server.js": {
      "maxDuration": 800
    },
    "api/tick.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/((?!api/tick$).*)",
      "destination": "/api/server"
    }
  ]
}
