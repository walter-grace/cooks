{
  "name": "cooks-mcp",
  "version": "0.6.0",
  "description": "MCP server for Cooks (open-source sales engagement). Works with Claude Code, Claude Desktop, Cursor, Grok.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cooks-mcp": "./bin/cooks-mcp.js"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/http.ts",
    "stdio": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/walter-grace/cooks",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/walter-grace/cooks/blob/main/docs/mcp.md",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sales-engagement",
    "claude",
