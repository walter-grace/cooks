# Postgres (Homebrew default: postgres://localhost:5432/cooks)
DATABASE_URL=postgres://localhost:5432/cooks
# Public URLs (used in links, OAuth metadata, MCP resource metadata)
COOKS_PUBLIC_URL=http://localhost:8080
COOKS_MCP_PUBLIC_URL=http://localhost:8081
# 32-byte base64 key encrypting mailbox credentials, webhook secrets, provider keys at rest
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKS_KEK=
# Run migrations on boot
COOKS_AUTO_MIGRATE=true
# Issue keys as cooks-api-... (set to "nooks" for strict drop-in clients that regex-check the prefix)
COOKS_API_KEY_PREFIX=cooks
# Outbound mail in dev: Mailpit (brew install mailpit; mailpit)  UI http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
# Optional LLM providers (hosted agent features stay off without one)
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
# Mailbox connectors (optional). Redirect URIs: $COOKS_PUBLIC_URL/connect/google/callback and /connect/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# HubSpot OAuth app (optional; private-app tokens work without it). Redirect: $COOKS_PUBLIC_URL/connect/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Clerk SSO (optional). Set CLERK_SECRET_KEY to switch the login page to Clerk; see docs/auth.md
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
# Workspace slug for Clerk users without an organization (otherwise each gets a personal workspace)
COOKS_CLERK_DEFAULT_WORKSPACE=
# Dialer on Twilio. Credentials can be pasted per workspace in Settings → Dialer, or set here for every workspace.
# Account SID + Auth Token are enough for phone mode (Twilio rings the rep first). Browser calling and the
# power dialer's browser mode also need a Standard API key pair and a TwiML App whose Voice URL is
#   $COOKS_PUBLIC_URL/telephony/voice?ws=<workspace id>
# Twilio must reach COOKS_PUBLIC_URL for webhooks: locally run `ngrok http 8080` and put the https URL in COOKS_PUBLIC_URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Override the Twilio REST base only for the mock (scripts/qa/mock-twilio.mjs → http://127.0.0.1:18100)
TWILIO_API_BASE=
# Speko AI dialer (optional server-wide key; each workspace can paste its own under Settings → Dialer). Override the base only for mocks.
SPEKO_API_KEY=
SPEKO_API_BASE=
# Inkbox channels (email, SMS, iMessage, hosted calls). Keys are pasted per workspace under Settings → Channels; override the base only for mocks.
INKBOX_API_BASE=
# Call transcription: any OpenAI-compatible speech-to-text endpoint (falls back to the OpenAI key)
TRANSCRIBE_API_BASE=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# Parallel dialer fast pickup (speech gate): hear "Hello?" and connect before carrier AMD.
# off (default) | mock (QA with scripts/qa/mock-twilio.mjs) | openai (Realtime transcription; SPEECH_API_KEY or OPENAI_API_KEY)
# | sherpa (local sherpa-onnx streaming model in SPEECH_MODEL_DIR; needs `pnpm add sherpa-onnx-node` in apps/api)
SPEECH_PROVIDER=off
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_MODEL_DIR=
# Tie-breaker for unclear pickups: TypeSafe Jev on OpenRouter (uses OPENROUTER_API_KEY). Enable per workspace in Settings → Dialer.
SPEECH_JEV_MODEL=typesafe/jev-1.14
LOG_LEVEL=info
PORT=8080
