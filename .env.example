# Postgres (Homebrew default: postgres://localhost:5432/cooks)
DATABASE_URL=postgres://localhost:5432/cooks
# Public URLs (used in links, OAuth metadata, MCP resource metadata)
COOKS_PUBLIC_URL=http://localhost:8080
COOKS_MCP_PUBLIC_URL=http://localhost:8081
# 32-byte base64 key encrypting mailbox credentials, webhook secrets, provider keys at rest
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COOKS_KEK=
# Run migrations on boot
COOKS_AUTO_MIGRATE=true
# Issue keys as cooks-api-... (set to "nooks" for strict drop-in clients that regex-check the prefix)
COOKS_API_KEY_PREFIX=cooks
# Outbound mail in dev: Mailpit (brew install mailpit; mailpit)  UI http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Optional LLM providers (hosted agent features stay off without one)
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
# Mailbox connectors (optional). Redirect URIs: $COOKS_PUBLIC_URL/connect/google/callback and /connect/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# HubSpot OAuth app (optional; private-app tokens work without it). Redirect: $COOKS_PUBLIC_URL/connect/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Clerk SSO (optional). Set CLERK_SECRET_KEY to switch the login page to Clerk; see docs/auth.md
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
# Workspace slug for Clerk users without an organization (otherwise each gets a personal workspace)
COOKS_CLERK_DEFAULT_WORKSPACE=
# Dialer (Twilio credentials are entered per workspace in Settings → Dialer). Override the API base only for mocks.
TWILIO_API_BASE=
# Call transcription: any OpenAI-compatible speech-to-text endpoint (falls back to the OpenAI key)
TRANSCRIBE_API_BASE=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
LOG_LEVEL=info
PORT=8080
